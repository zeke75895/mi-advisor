# Copy to .env and fill in. Never commit .env.

# Backend (Spring Boot)
DATABASE_URL=jdbc:postgresql://localhost:5432/coursecompass
DATABASE_USERNAME=coursecompass
DATABASE_PASSWORD=coursecompass
ML_SERVICE_URL=http://localhost:8000
# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# LLM / voice
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# AI caps: generations per user per window, and total Gemini calls per minute
AI_USER_LIMIT=10
AI_USER_WINDOW=PT10M
AI_GLOBAL_LIMIT_PER_MINUTE=15
ELEVENLABS_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8080
